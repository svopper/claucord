# Settings for hosting BEAM Chat for people on other networks.
# Copy this file to .env and fill it in. .env is ignored by git (it holds secrets).
#
# Start the TURN server:   bin/turn
# Start the chat:          set -a; . ./.env; set +a; mix chat --nodes 4

# Shared secret between the chat and the TURN server. Generate one with:
#   openssl rand -hex 32
CHAT_TURN_SECRET=

# Your public IP address: the one your friends connect to.
TURN_PUBLIC_IP=

# Optional: this machine's address on your home network (what the router
# forwards to). bin/turn finds it by itself.
# TURN_LAN_IP=192.168.1.20

# What browsers are told. Replace YOUR_PUBLIC_IP with the same address as above.
CHAT_TURN_URLS=turn:YOUR_PUBLIC_IP:3478,turn:YOUR_PUBLIC_IP:3478?transport=tcp
CHAT_STUN_URLS=stun:YOUR_PUBLIC_IP:3478

# Recommended while the chat is reachable from the internet:
# CHAT_INVITE_CODE=pick-something
# CHAT_DEMO_COMMANDS=false
